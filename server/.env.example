# ==============================================================================
# FIORE E-COMMERCE - VARIÁVEIS DE AMBIENTE DO BACKEND (SERVER)
# ==============================================================================

# Conexão com o Banco de Dados PostgreSQL (Local ou Supabase com Pooling/PgBouncer na porta 6543)
# Exemplo Local: postgresql://postgres:senha@localhost:5432/fiore_db?schema=public
# Exemplo Supabase: postgresql://postgres.[PROJECT_REF]:[SENHA]@aws-0-[REGIAO].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fiore_db?schema=public"

# Conexão Direta com o PostgreSQL (Necessário para Migrations do Prisma no Supabase na porta 5432)
# Exemplo Local: igual ao DATABASE_URL
# Exemplo Supabase: postgresql://postgres.[PROJECT_REF]:[SENHA]@aws-0-[REGIAO].pooler.supabase.com:5432/postgres
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/fiore_db?schema=public"

# Porta onde o servidor Express irá responder (Padrão: 3333)
PORT=3333

# Segredo utilizado pelo express-session para criptografia/assinatura dos cookies
SESSION_SECRET="coloque_uma_chave_secreta_longa_e_aleatoria_aqui"

# URL da aplicação Frontend (React / Vite) para configuração de CORS e envio de cookies
CLIENT_URL="http://localhost:5173"

# Ambiente de execução: development | production | test
NODE_ENV="development"
