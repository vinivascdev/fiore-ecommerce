generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TipoUsuario {
  CLIENTE
  ADMIN
}

model Usuario {
  id_usuario   Int         @id @default(autoincrement())
  nome         String
  email        String      @unique
  login        String      @unique
  senha        String
  endereco     String
  tipo_usuario TipoUsuario @default(CLIENTE)

  pedidos      Pedido[]

  @@map("usuarios")
}

model Categoria {
  id_categoria Int       @id @default(autoincrement())
  nome         String

  produtos     Produto[]

  @@map("categorias")
}

model Produto {
  id_produto         Int      @id @default(autoincrement())
  id_categoria       Int
  nome               String
  descricao_olfativa String
  preco              Decimal  @db.Decimal(10, 2)
  quantidade_estoque Int
  imagem_url         String

  categoria          Categoria      @relation(fields: [id_categoria], references: [id_categoria])
  itens_pedido       ItemPedido[]
  itens_carrinho     CarrinhoItem[]

  @@map("produtos")
}

model Pedido {
  id_pedido   Int          @id @default(autoincrement())
  id_cliente  Int
  data_pedido DateTime     @default(now())
  valor_total Decimal      @db.Decimal(10, 2)

  cliente     Usuario      @relation(fields: [id_cliente], references: [id_usuario])
  itens       ItemPedido[]

  @@map("pedidos")
}

model ItemPedido {
  id_item_pedido Int     @id @default(autoincrement())
  id_pedido      Int
  id_produto     Int
  quantidade     Int
  preco_unitario Decimal @db.Decimal(10, 2)

  pedido         Pedido  @relation(fields: [id_pedido], references: [id_pedido])
  produto        Produto @relation(fields: [id_produto], references: [id_produto])

  @@map("itens_pedido")
}

model CarrinhoItem {
  id_carrinho_item Int     @id @default(autoincrement())
  session_id       String
  id_produto       Int
  quantidade       Int

  produto          Produto @relation(fields: [id_produto], references: [id_produto])

  @@map("carrinho_itens")
}
